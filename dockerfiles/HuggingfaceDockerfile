ARG PYTHON_VERSION=3.12

# ============================================================
# HUGGING FACE SPACE — BUILD + RUNTIME
# ============================================================
# trixie, not bookworm:
# Intel's NEO/IGC debs are built on Ubuntu 24.04 and need
# glibc >= 2.38 / libstdc++ >= 13.1. bookworm is 2.36 / 12.2
# and cannot host them, and its Level Zero loader (libze1 1.8.12)
# predates zesInit.
FROM python:${PYTHON_VERSION}-slim-trixie

ARG APP_VERSION=26.11.23
# Hugging Face builds the image on a machine without GPU, whatever
# hardware the Space runs on: nothing can be detected here. The image
# is CUDA, and the GPU is detected when the container starts: CUDA on
# GPU hardware, CPU on CPU hardware (the CUDA torch runs there too), so
# a hardware change needs no rebuild. Space variables are passed as
# build args, so DEVICE_TAG can be set in Settings > Variables and
# secrets, then Factory rebuild:
#   cu126  NVIDIA T4, L4, L40S, A10G, A100, H100 and CPU (default):
#          CUDA 12.6 torch, runs on any 12.x driver
#   cu132  same, needs a driver >= 580 on the Space (CPU otherwise)
#   cpu    CPU only: a smaller image, no GPU ever
# DOCKER_DEVICE_STR, when set, overrides DEVICE_TAG with a full
# device_info json.
ARG DEVICE_TAG=cu126
ARG DOCKER_DEVICE_STR=''
ARG DOCKER_PROGRAMS_STR="curl ffmpeg mediainfo nodejs npm espeak-ng sox tesseract-ocr"
ARG CALIBRE_INSTALLER_URL="https://download.calibre-ebook.com/linux-installer.sh"
ARG ISO3_LANG=eng
ARG INSTALL_RUST=1

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1 \
    PYTHONIOENCODING=utf-8 \
    UV_SYSTEM_PYTHON=1 \
    UV_LINK_MODE=copy \
    DOCKER_DEVICE_STR=${DOCKER_DEVICE_STR} \
    DEVICE_TAG=${DEVICE_TAG} \
    TTS_CACHE=/app/models \
    TESSDATA_PREFIX=/app/models/tessdata \
    TMPDIR=/app/run \
    GRADIO_SERVER_NAME=0.0.0.0 \
    GRADIO_SERVER_PORT=7860 \
    PATH="/root/.local/bin:/root/.cargo/bin:${PATH}" \
    IN_DOCKER=1 \
	UV_PYTHON_INSTALL_DIR="/app/lib/classes/tts_engines/venvs/.python" \
	UV_LINK_MODE="copy"

# what the nvidia/cuda images declare: a host on the nvidia runtime mounts
# the GPU and its driver (libcuda, nvidia-smi) only into a container asking
# for them. No effect on CPU hardware, where nothing reads them.
ENV NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

# uv is required because device_installer.py now calls `uv pip ...`.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

# System packages.
#
# DOCKER_PROGRAMS_STR is passed by the build script when available.
# tesseract-ocr-[lang] and calibre are handled below.
RUN set -eux; \
	apt-get update; \
	apt-get install -y --no-install-recommends \
		ca-certificates \
		wget \
		git \
		xz-utils \
		build-essential \
		gcc \
		g++ \
		make \
		pkg-config \
		cmake \
		python3-dev \
		libgomp1 \
		libglib2.0-0 \
		libgl1 \
		libsndfile1 \
		libstdc++6 \
		libgcc-s1 \
		libegl1 \
		libopengl0 \
		libxcb-cursor0 \
		libxcb-xinerama0 \
		libxkbcommon-x11-0 \
		${DOCKER_PROGRAMS_STR}; \
	if [ -n "${ISO3_LANG}" ]; then \
		apt-get install -y --no-install-recommends "tesseract-ocr-${ISO3_LANG}" || true; \
	fi; \
	rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    mkdir -p \
        /app/ebooks \
        /app/audiobooks \
        /app/models \
        /app/models/tessdata \
        /app/voices \
        /app/run \
        /app/tmp; \
    chmod -R 777 /app/ebooks /app/audiobooks /app/models /app/voices /app/run /app/tmp

RUN set -eux; \
    if ! command -v ebook-convert >/dev/null 2>&1; then \
        wget -nv -O- "${CALIBRE_INSTALLER_URL}" | sh /dev/stdin; \
    fi; \
    ebook-convert --version

RUN set -eux; \
    if [ "${INSTALL_RUST}" = "1" ]; then \
        curl -fsSL https://sh.rustup.rs | sh -s -- -y; \
    fi

RUN set -eux; \
    uv pip install --system --no-cache 'setuptools<82' wheel

COPY . /app

RUN set -eux; \
    if [ -f ./ebook2audiobook.command ]; then \
        chmod +x ./ebook2audiobook.command; \
    elif [ -f ./e2a.sh ]; then \
        chmod +x ./e2a.sh; \
        ln -sf ./e2a.sh ./ebook2audiobook.command; \
    elif [ -f ./ebook2audiobook.sh ]; then \
        chmod +x ./ebook2audiobook.sh; \
        ln -sf ./ebook2audiobook.sh ./ebook2audiobook.command; \
    else \
        echo "No launcher found: expected ebook2audiobook.command, e2a.sh, or ebook2audiobook.sh"; \
        exit 1; \
    fi

RUN set -eux; \
    if [ -z "${DOCKER_DEVICE_STR}" ]; then \
        case "${DEVICE_TAG}" in \
            cpu) device_name=cpu ;; \
            cu[0-9]*) device_name=cuda ;; \
            *) echo "DEVICE_TAG='${DEVICE_TAG}' is not a Hugging Face device: cpu or cuXYZ (e.g. cu126)"; exit 1 ;; \
        esac; \
        DOCKER_DEVICE_STR="{\"name\": \"${device_name}\", \"os\": \"manylinux_2_28\", \"arch\": \"x86_64\", \"pyvenv\": [3, 12], \"tag\": \"${DEVICE_TAG}\", \"note\": \"Hugging Face ${device_name} device\"}"; \
    fi; \
    ./ebook2audiobook.command --script_mode build_docker --docker_device "${DOCKER_DEVICE_STR}"; \
    rustup self uninstall -y 2>/dev/null || true; \
    apt-get update; \
    apt-get purge -y --auto-remove \
        gcc \
        g++ \
        make \
        pkg-config \
        cmake \
        wget \
        git \
        xz-utils \
        python3-dev \
        build-essential || true; \
    rm -rf \
        /var/lib/apt/lists/* \
        /root/.cargo \
        /root/.rustup \
        /tmp/* \
        /app/tmp/* \
        /app/run/* || true

VOLUME ["/app/ebooks", "/app/audiobooks", "/app/models", "/app/voices", "/app/run", "/app/tmp"]

EXPOSE 7860

CMD ["bash", "ebook2audiobook.command", "--script_mode", "full_docker"]